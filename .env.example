# Copy to .env and fill in values. Do NOT commit .env.

# SQL Server connection for collector/recommender
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong!Passw0rd
SQLSERVER_DATABASE=AutotunerDemo

# Feature store database/schema (if separate)
FEATURE_STORE_DATABASE=AutotunerDemo

# Optional: dashboard API
DASHBOARD_API_BASEURL=http://localhost:8080

# Local API startup (does not connect to SQL Server)
AUTOTUNER_API_HOST=127.0.0.1
AUTOTUNER_API_PORT=8080

# AutoTunerRepository
AUTOTUNER_REPO_SQL_DRIVER=ODBC Driver 18 for SQL Server
AUTOTUNER_REPO_SQL_SERVER=localhost\SQLEXPRESS
AUTOTUNER_REPO_SQL_DATABASE=AutoTunerRepository
AUTOTUNER_REPO_SQL_TRUSTED_CONNECTION=yes
AUTOTUNER_REPO_SQL_TRUST_SERVER_CERTIFICATE=yes

# Leave username/password unset for Windows authentication.
# For SQL authentication:
# AUTOTUNER_REPO_SQL_TRUSTED_CONNECTION=no
# AUTOTUNER_REPO_SQL_USERNAME=autotuner_repository
# AUTOTUNER_REPO_SQL_PASSWORD=use-a-secret-store

AUTOTUNER_INITIAL_LOOKBACK_MINUTES=60
AUTOTUNER_METADATA_REFRESH_MINUTES=60